PORT=8888
NODE_ENV=development

# Mesma base de dados existente - NAO alterar
DATABASE_URL="postgresql://usuario:senha@host:porta/banco"

# Deve ser o mesmo segredo usado na API antiga para nao invalidar tokens existentes
AUTH_SECRET="troque-por-um-segredo-forte"

# CORS - dominios do front autorizados (separados por virgula)
CORS_ORIGINS="http://localhost:5173"

# SMTP para alerta de erros
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vendas Alerts <no-reply@example.com>"
ERROR_ALERT_EMAIL=
